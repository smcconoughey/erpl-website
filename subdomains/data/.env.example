# Copy to .env and set a shared club password. Never use a VITE_ prefix for secrets.
ERPL_DATA_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ERPL_SESSION_SECRET=
# Direct local connections use 0; set to the verified proxy hop count in hosting.
TRUST_PROXY_HOPS=0
